# ==============================================================================
# 方式一（推荐 · 纯个人无营业执照）：爱猹收（WatchaPay · 支付宝 Vibe Pay 合作平台）
# 资金通过支付宝即刻收直达个人支付宝账号
# ==============================================================================
WATCHA_BASE_URL=https://pay.watcha.cn
WATCHA_API_KEY=
WATCHA_ENTITLEMENT_ID=
WATCHA_BILLING_MODE=one_time
# 服务端 HMAC-SHA256 防伪通行码密钥（至少 32 位随机字符，绝不提交到 Git）
SESSION_SECRET=

# ==============================================================================
# 方式二（企业/个体户直连）：支付宝开放平台 AI 网页应用收款（alipay.trade.page.pay）
# ==============================================================================
PORT=3088
PUBLIC_BASE_URL=http://127.0.0.1:3088
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
