# 支付宝 AI 网页应用收款（Vibe Pay / alipay.trade.page.pay）配置模板
# 请勿将真实私钥提交至 Git 仓库

PORT=3088
PUBLIC_BASE_URL=http://127.0.0.1:3088

# 运行模式：sandbox（官方沙箱）| production（正式生产）| demo（无密钥本地体验）
ALIPAY_ENV=sandbox

# 支付宝开放平台应用 ID
ALIPAY_APP_ID=

# 应用私钥（PKCS8 单行或 PEM，仅保存在服务端环境变量，绝不暴露前端）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（用于服务端校验异步通知与回跳签名）
ALIPAY_PUBLIC_KEY=

# 可选：自定义公网异步通知地址（留空时仅依赖 return_url + 服务端 alipay.trade.query 主动确认）
ALIPAY_NOTIFY_URL=
